{
  "name": "personal-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "predev": "node scripts/optimize-images.js",
    "optimize": "node scripts/optimize-images.js",
    "prebuild": "node scripts/optimize-images.js",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@lucide/svelte": "^1.55.0",
    "@vercel/speed-insights": "^2.0.0",
    "front-matter": "^4.0.2",
    "marked": "^18.1.1",
    "simple-icons": "^16.35.0"
  },
  "overrides": {
    "@vercel/speed-insights": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  }
}
