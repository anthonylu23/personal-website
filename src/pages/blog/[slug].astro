---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import { BLOG_ENABLED } from '../../config/features'
import { getPublishedPosts } from '../../lib/blog'
import type { BlogPost } from '../../lib/blog'
import { formatCalendarDate } from '../../lib/dates'
import Base from '../../layouts/Base.astro'

export const getStaticPaths = (async () => {
  if (!BLOG_ENABLED) return []
  const posts = await getPublishedPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}) satisfies GetStaticPaths

type Props = { post: BlogPost }

const { post } = Astro.props
const { Content } = await render(post)
---

<Base title={`${post.data.title} · luanthony.xyz`} description={post.data.description || undefined}>
  <main
    class="mx-auto flex max-w-3xl flex-col px-4 pb-[calc(6rem+var(--safe-area-bottom,0px))] pt-[calc(8rem+var(--safe-area-top,0px))] lg:px-0"
  >
    <a href="/blog" class="mb-8 text-xl text-textSecondary transition hover:text-accent" aria-label="Back to blog">
      &larr;
    </a>
    <header class="mb-10">
      <h1 class="text-3xl font-semibold text-textPrimary text-balance md:text-4xl">{post.data.title}</h1>
      <p class="mt-3 text-sm text-textSecondary/70">{formatCalendarDate(post.data.date)}</p>
    </header>
    <article class="prose-custom">
      <Content />
    </article>
  </main>
</Base>
