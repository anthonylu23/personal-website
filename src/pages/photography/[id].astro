---
import type { GetStaticPaths } from 'astro'
import { gallery } from '../../data/gallery'
import type { GalleryItem } from '../../data/gallery'
import Base from '../../layouts/Base.astro'

export const getStaticPaths = (() =>
  gallery.map((project) => ({
    params: { id: project.id },
    props: { project },
  }))) satisfies GetStaticPaths

type Props = { project: GalleryItem }

const { project } = Astro.props
---

<Base title={`${project.title} · luanthony.xyz`} showNav={false}>
  <main class="min-h-screen bg-base px-6 pb-20 pt-24 md:px-10">
    <div
      class="fixed inset-x-0 top-0 z-50 px-6 pt-4 md:px-10"
      style="padding-top: calc(1rem + env(safe-area-inset-top, 0px));"
    >
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between py-3">
        <a href="/photography" class="text-2xl font-medium text-textPrimary/80 hover:text-accent" aria-label="Back">
          ←
        </a>
        <p class="text-right text-sm font-medium text-textPrimary/60">{project.title}</p>
      </div>
    </div>
    <section class="mx-auto flex max-w-6xl flex-col gap-10">
      <div class="grid grid-cols-1 gap-10">
        {
          project.galleryImages.map((src, index) => (
            <figure
              class="animate-rise-in w-full"
              style={`--rise-distance: 1rem; animation-delay: ${Math.min(index * 60, 180)}ms`}
            >
              <img
                src={src}
                alt={`${project.title} photo ${index + 1}`}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="animate-settle-in mx-auto h-[88vh] w-auto max-w-full object-contain"
                style="--settle-scale: 1.02"
              />
            </figure>
          ))
        }
      </div>
    </section>
  </main>
</Base>
