---
// Shared minimal view for not-found and error states.
type Props = {
  code?: string
  message: string
}

const { code, message } = Astro.props
---

<main class="flex min-h-screen items-center justify-center px-4">
  <p class="text-sm text-textSecondary/60">
    {code && <span class="text-textSecondary">{code}</span>}
    {code && <span class="mx-3 text-textSecondary/30">|</span>}
    {message}
  </p>
</main>
